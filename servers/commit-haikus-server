#!/usr/bin/env python3
import json
import sys
import os
import subprocess
import re
import random

sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from commit_haiku.haiku import generate_haiku, analyze_diff


def log_debug(msg):
    pass


def send_message(msg):
    line = json.dumps(msg)
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def recv_message():
    line = sys.stdin.readline()
    if not line:
        return None
    return json.loads(line.strip())


def handle_initialize(msg):
    send_message({
        "jsonrpc": "2.0",
        "id": msg["id"],
        "result": {
            "protocolVersion": "2024-11-05",
            "capabilities": {
                "tools": {}
            },
            "serverInfo": {
                "name": "commit-haiku",
                "version": "0.1.0"
            }
        }
    })


def handle_tools_list(msg):
    send_message({
        "jsonrpc": "2.0",
        "id": msg["id"],
        "result": {
            "tools": [
                {
                    "name": "generate_commit_haiku",
                    "description": "Generate a haiku poem from the current git diff. Analyzes staged or unstaged changes and crafts a 5-7-5 syllable haiku reflecting the nature of the changes (additions, fixes, removals, or refactors).",
                    "inputSchema": {
                        "type": "object",
                        "properties": {
                            "diff_text": {
                                "type": "string",
                                "description": "Optional git diff text to use instead of auto-detecting from the repository"
                            }
                        }
                    }
                }
            ]
        }
    })


def handle_tools_call(msg):
    params = msg.get("params", {})
    name = params.get("name", "")
    arguments = params.get("arguments", {})

    if name == "generate_commit_haiku":
        diff_text = arguments.get("diff_text", "")
        try:
            if diff_text:
                analysis = analyze_diff()
                if diff_text:
                    analysis["diff"] = diff_text
                    added = len(re.findall(r"^\+", diff_text, re.MULTILINE))
                    removed = len(re.findall(r"^\-", diff_text, re.MULTILINE))
                    analysis["added"] = added
                    analysis["removed"] = removed
                    if added > removed * 3:
                        analysis["kind"] = "add"
                    elif removed > added * 3:
                        analysis["kind"] = "remove"
                    elif added + removed > 50:
                        analysis["kind"] = "refactor"
                    else:
                        analysis["kind"] = "general"
                    kw = re.findall(r"\b(fix|bug|hotfix|patch|repair|broken)\b", diff_text, re.IGNORECASE)
                    if kw:
                        analysis["kind"] = "fix"
            else:
                analysis = analyze_diff()

            haiku = generate_haiku(analysis)

            send_message({
                "jsonrpc": "2.0",
                "id": msg["id"],
                "result": {
                    "content": [
                        {
                            "type": "text",
                            "text": f"\n{haiku}\n"
                        }
                    ]
                }
            })
        except Exception as e:
            send_message({
                "jsonrpc": "2.0",
                "id": msg["id"],
                "error": {
                    "code": -32603,
                    "message": str(e)
                }
            })
    else:
        send_message({
            "jsonrpc": "2.0",
            "id": msg["id"],
            "error": {
                "code": -32601,
                "message": f"Unknown tool: {name}"
            }
        })


def handle_notification(msg):
    pass


def main():
    while True:
        msg = recv_message()
        if msg is None:
            break

        method = msg.get("method", "")
        if method == "initialize":
            handle_initialize(msg)
        elif method == "notifications/initialized":
            handle_notification(msg)
        elif method == "tools/list":
            handle_tools_list(msg)
        elif method == "tools/call":
            handle_tools_call(msg)
        elif method == "notifications/cancelled":
            pass


if __name__ == "__main__":
    main()
